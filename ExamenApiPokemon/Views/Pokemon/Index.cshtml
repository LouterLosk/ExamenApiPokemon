@model ExamenApiPokemon.Models.PokemonListaViewModel
@using ExamenApiPokemon.Models
@{
    ViewBag.Title = "Pokédex";
    Layout = "~/Views/Shared/_LayoutPortal.cshtml";
    int delay = 0;
}

<aside class="lado">

    <form class="mini-pantalla" action="@Url.Action("Index", "Pokemon")" method="get">
        <p class="etq">ESCÁNER</p>
        <input class="campo" type="text" name="q" value="@Model.Q" placeholder="Nombre o # (ej. pikachu)"
               aria-label="Buscar Pokémon" autocomplete="off" />
        <select class="campo" name="tipo" aria-label="Tipo">
            <option value="">Cualquier tipo</option>
            <option value="normal" @(Model.Tipo == "normal" ? "selected" : "")>Normal</option>
            <option value="fire" @(Model.Tipo == "fire" ? "selected" : "")>Fuego</option>
            <option value="water" @(Model.Tipo == "water" ? "selected" : "")>Agua</option>
            <option value="electric" @(Model.Tipo == "electric" ? "selected" : "")>Eléctrico</option>
            <option value="grass" @(Model.Tipo == "grass" ? "selected" : "")>Planta</option>
            <option value="ice" @(Model.Tipo == "ice" ? "selected" : "")>Hielo</option>
            <option value="fighting" @(Model.Tipo == "fighting" ? "selected" : "")>Lucha</option>
            <option value="poison" @(Model.Tipo == "poison" ? "selected" : "")>Veneno</option>
            <option value="ground" @(Model.Tipo == "ground" ? "selected" : "")>Tierra</option>
            <option value="flying" @(Model.Tipo == "flying" ? "selected" : "")>Volador</option>
            <option value="psychic" @(Model.Tipo == "psychic" ? "selected" : "")>Psíquico</option>
            <option value="bug" @(Model.Tipo == "bug" ? "selected" : "")>Bicho</option>
            <option value="rock" @(Model.Tipo == "rock" ? "selected" : "")>Roca</option>
            <option value="ghost" @(Model.Tipo == "ghost" ? "selected" : "")>Fantasma</option>
            <option value="dragon" @(Model.Tipo == "dragon" ? "selected" : "")>Dragón</option>
            <option value="dark" @(Model.Tipo == "dark" ? "selected" : "")>Siniestro</option>
            <option value="steel" @(Model.Tipo == "steel" ? "selected" : "")>Acero</option>
            <option value="fairy" @(Model.Tipo == "fairy" ? "selected" : "")>Hada</option>
        </select>
        <button type="submit" class="btn cian">ESCANEAR</button>
    </form>

    @if (Model.TotalPaginas > 1)
    {
        <nav class="mini-pantalla" aria-label="Paginación">
            <p class="etq">PÁGINA</p>
            <p class="pag-estado">@Model.Pagina / @Model.TotalPaginas</p>
            <div class="pag-botones">
                <a class="btn @(Model.Pagina <= 1 ? "gris" : "")"
                   href="@Url.Action("Index", "Pokemon", new { q = Model.Q, tipo = Model.Tipo, pagina = Model.Pagina - 1 })">◀</a>
                <a class="btn @(Model.Pagina >= Model.TotalPaginas ? "gris" : "")"
                   href="@Url.Action("Index", "Pokemon", new { q = Model.Q, tipo = Model.Tipo, pagina = Model.Pagina + 1 })">▶</a>
            </div>
        </nav>
    }

    <div class="mandos" aria-hidden="true">
        <div class="dial"></div>
        <div class="pulsadores"><i></i><i></i><i></i><i></i></div>
    </div>
</aside>

<section class="vidrio">
    <p class="etq">REGISTRO POKÉDEX @(Model.Total > 0 ? "· " + Model.Total + " ENCONTRADOS" : "")</p>

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alerta error">⚠ @Model.Error</div>
    }
    else if (!Model.Pokemones.Any())
    {
        <div class="vacio">No hay resultados para esa búsqueda.</div>
    }

    <div class="grid">
        @foreach (var p in Model.Pokemones)
        {
            var claseTipo = !string.IsNullOrEmpty(Model.Tipo) ? Model.Tipo : "unknown";
            <a class="card @claseTipo" href="@Url.Action("Detalle", "Pokemon", new { id = p.Id })" style="animation-delay:@(delay)ms">
                <div class="arte">
                    <span class="num">@p.NumeroFormateado</span>
                    <img src="@p.ImagenUrl" alt="@p.NombreCapitalizado" loading="lazy" />
                </div>
                <div class="info">
                    <h2 class="nombre">@p.NombreCapitalizado</h2>
                    <div class="estado">
                        <i></i>@(string.IsNullOrEmpty(Model.Tipo) ? "N.° " + p.Id : PokemonHelper.TipoEs(Model.Tipo))
                    </div>
                </div>
            </a>
            delay += 40;
        }
    </div>
</section>
